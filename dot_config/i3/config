# i3 config (simplified)
# Reference: https://i3wm.org/docs/userguide.html

### Modifiers
set $mod Mod4
set $alt Mod1

### Apps / scripts
set $term kitty
set $fm thunar
set $launcher ~/.config/rofi/launchers/type-2/launcher.sh

### Appearance
font pango:iosevka_nerd_font 0

gaps inner 10px
gaps outer 5px

### Autostart (run once)
exec --no-startup-id systemctl --user restart xdg-desktop-portal.service
exec --no-startup-id dex --autostart --environment i3
# exec --no-startup-id deskflow  # replaced by Synergy (synergy-dragon) 2026-10-02
exec --no-startup-id numlockx on
exec --no-startup-id dunst
exec --no-startup-id picom -b
exec --no-startup-id ~/.fehbg
exec --no-startup-id xset s off -dpms

### Autostart (re-run on reload)
exec_always --no-startup-id autotiling
exec_always --no-startup-id xrandr --dpi 84 --output DisplayPort-0 --mode 1920x1080 --rate 144 --pos 0x0 --primary

### Mouse
floating_modifier $mod

### Keybindings
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+Shift+q kill
bindsym $mod+space exec --no-startup-id $launcher
bindsym $mod+e exec --no-startup-id $fm

# Note: this logs you out of i3 (kept as-is from your config)
bindsym $mod+l exec --no-startup-id i3 exit

# Focus (custom: down/right + arrows)
bindsym $mod+k focus down
bindsym $mod+semicolon focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Layout
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+Shift+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+Shift+period workspace next
bindsym $mod+Shift+comma  workspace prev

# Reload / restart
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

### Audio keys (PulseAudio)
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute   @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

### Screenshots / OCR
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym $mod+Shift+t exec --no-startup-id normcap

# --- CoolerControl fan modes -------------------------------------------------
# Switches CoolerControl modes via ~/.local/bin/fanmode (REST API + bearer token)
bindsym $mod+Ctrl+1 exec --no-startup-id ~/.local/bin/fanmode quiet
bindsym $mod+Ctrl+2 exec --no-startup-id ~/.local/bin/fanmode normal
bindsym $mod+Ctrl+3 exec --no-startup-id ~/.local/bin/fanmode performance
bindsym $mod+Ctrl+4 exec --no-startup-id ~/.local/bin/fanmode full
# -----------------------------------------------------------------------------

### Headless streaming (fake 1080p60 HDMI-A-0, physical monitors off; toggle)
bindsym $mod+Shift+m exec --no-startup-id ~/.local/bin/headless-toggle

### Resize mode
mode "resize" {
    bindsym j resize shrink width  10 px or 10 ppt
    bindsym k resize grow   height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow  width  10 px or 10 ppt

    bindsym Left  resize shrink width  10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width  10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r  mode "default"
}

bindsym $mod+$alt+r mode "resize"

### Bar
bar {
    height 25
    tray_output primary
    position top
    font pango: 3270 Nerd Font Mono SemCond, DejaVu Sans Mono 14

    status_command i3status-rs ~/.config/i3status-rust/config.toml

    colors {
        statusline #00ff00
        background #676767
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}

