// Let bocaj start/stop headless-display.service without a password prompt
// (used by the i3 $mod+Shift+m headless toggle).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "headless-display.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.user == "bocaj") {
        return polkit.Result.YES;
    }
});
